# Mescle estas locations no server HTTPS existente do Hub.
# A location com prefixo ^~ evita que uma regex genérica de arquivos .js/.json a sobreponha.
location ^~ /remotes/ordens-compra/ {
    proxy_pass http://127.0.0.1:4305/;
    proxy_set_header Host $host;
    add_header Cache-Control "no-cache" always;
}

# Ajuste o upstream para o endereço REAL do Flask no servidor/rede Docker.
# 127.0.0.1:5000 abaixo é somente um exemplo para Flask rodando na mesma VPS.
location ^~ /ordens-compra-api/ {
    proxy_pass http://127.0.0.1:5000/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
